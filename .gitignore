# COMFYUI ARTIFACTS
# ============================================================================

# Generated images and outputs
outputs/
output/
temp/
tmp/

# ComfyUI models (large files)
models/
checkpoints/
loras/
embeddings/

# ComfyUI cache
comfy_cache/

# ============================================================================
# MCP SERVER ARTIFACTS
# ============================================================================

# MCP server logs
*.log
logs/

# MCP cache
.mcp_cache/

# ============================================================================
# IDE & EDITORS
# ============================================================================

# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ============================================================================
# OPERATING SYSTEM
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================================================
# TEMPORARY & BACKUP FILES
# ============================================================================

# Backup files
*.bak
*.backup
*.old
*.orig

# Temporary files
*.tmp
*.temp

# ============================================================================
# PROJECT SPECIFIC
# ============================================================================

# Test artifacts
.pytest_tmp/
test_outputs/

# Development notes
NOTES.md
TODO.md
SCRATCH.md

# Local configuration overrides
local_config.yaml
local_settings.yaml

# Database files (if any)
*.db
*.sqlite

# Keep important empty directories
!.gitkeep
