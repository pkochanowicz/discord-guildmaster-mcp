# ============================================================================
# Discord Guildmaster MCP Configuration
# ============================================================================
# Generated: 2025-12-23 | DDD Phase 1: Documentation Genesis
#
# Complete environment variable template for production deployment
# Copy this file to .env and customize for your environment
#
# See docs/CONFIGURATION.md for detailed documentation
# ============================================================================

# === REQUIRED ===

# Discord bot token from https://discord.com/developers/applications
# NEVER commit this to version control
# Format: MTIzNDU2Nzg5MDEyMzQ1Njc4OQ.AbCdEf.GhIjKlMnOpQrStUvWxYz
DISCORD_TOKEN=

# === DISCORD DEFAULTS ===
# Reduces per-call parameter overhead for multi-agent workflows

# Default guild (server) ID - makes guild_id optional in most tools
# Get from: Discord → Enable Developer Mode → Right-click server → Copy Server ID
DISCORD_DEFAULT_GUILD_ID=

# Default channel ID - useful for single-channel workflows
DISCORD_DEFAULT_CHANNEL_ID=

# Discord Gateway Intents (advanced users only)
# Default covers most use cases
# Must enable corresponding intents in Discord Developer Portal
DISCORD_INTENTS=default,members,message_content

# === THEMING ===

# Theme mode: generic (universal) | wow (World of Warcraft) | custom (BYOW)
# generic: send_message, list_members (fork-friendly)
# wow: summon_herald, muster_roster (immersive)
# custom: Load from GUILDMASTER_THEME_PATH
GUILDMASTER_THEME=generic

# Path to custom theme file (required if GUILDMASTER_THEME=custom)
# GUILDMASTER_THEME_PATH=./themes/custom.yaml

# === COMFYUI INTEGRATION (Optional) ===

# Enable ComfyUI image generation (requires ComfyUI server)
COMFYUI_ENABLED=false

# ComfyUI server connection
# localhost for local development
# IP/hostname for remote server
COMFYUI_HOST=localhost
COMFYUI_PORT=8188

# Workflow directory (contains .json workflow files)
# Default: ./workflows (includes 4 presets)
COMFYUI_WORKFLOW_DIR=./workflows

# Randomize seeds for variety in batch generation
# true: Each generation unique
# false: Reproducible results (for debugging)
COMFYUI_RANDOMIZE_SEEDS=true

# Generation timeout in seconds
# 300 (5 min) for SD 1.5
# 600 (10 min) for SDXL
COMFYUI_TIMEOUT=300

# Image return mode: base64 (embeddable) | url (link) | cdn (upload)
# base64: Works with localhost, increases token usage
# url: Requires public ComfyUI server
# cdn: Upload to S3/R2, persistent hosting
COMFYUI_RETURN_MODE=base64

# CDN configuration (when COMFYUI_RETURN_MODE=cdn)
# Uncomment and configure for CDN mode
# COMFYUI_CDN_PROVIDER=s3
# COMFYUI_CDN_BUCKET=my-guild-images
# COMFYUI_CDN_REGION=us-east-1
# COMFYUI_CDN_ACCESS_KEY=
# COMFYUI_CDN_SECRET_KEY=

# === SERVER BEHAVIOR ===

# MCP transport: stdio (default, for Claude Desktop/Cursor) | http (remote)
MCP_TRANSPORT=stdio

# HTTP server configuration (when MCP_TRANSPORT=http)
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# === TOKEN EFFICIENCY ===

# Default pagination size for list operations
# 25: Small context (4K models)
# 50: Standard context (32K models)
# 100: Large context (200K+ models)
DEFAULT_PAGE_SIZE=50

# Maximum message history retrievable in single call
# Prevents accidental context overflow
MAX_MESSAGE_HISTORY=100

# Truncate large text fields in responses
# Reduces token usage for long messages/descriptions
RESPONSE_TRUNCATION=true

# Character limit for truncated fields
EMBED_TRUNCATION_LENGTH=500

# === LOGGING & DEBUGGING ===

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# DEBUG: Verbose (development)
# INFO: Standard (production)
# WARNING: Only warnings/errors
LOG_LEVEL=INFO

# Log format: json (structured, for aggregation) | text (human-readable)
# json: {"timestamp": "...", "level": "INFO", "message": "..."}
# text: 2025-12-23 10:30:00 INFO Message here
LOG_FORMAT=json

# Optional: Write logs to file (in addition to stdout)
# LOG_FILE=/var/log/guildmaster/server.log

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# 
# Quick Start:
# 1. Copy: cp .env.example .env
# 2. Set DISCORD_TOKEN from Developer Portal
# 3. Set DISCORD_DEFAULT_GUILD_ID from Discord
# 4. Start server: guildmaster
#
# Documentation: docs/CONFIGURATION.md
# Troubleshooting: docs/TROUBLESHOOTING.md
# ============================================================================
