# Discord Guildmaster MCP - Environment Configuration Template
# Copy this to .env and fill in your actual values

# ============================================================================
# REQUIRED - Discord Bot Configuration
# ============================================================================

# Discord bot token from https://discord.com/developers/applications
# NEVER commit this token to git
DISCORD_TOKEN=your_bot_token_here

# ============================================================================
# OPTIONAL - Discord Defaults (Recommended for single-guild usage)
# ============================================================================

# Default guild (server) ID - makes guild_id optional in all tool calls
# Right-click server → Copy Server ID (requires Developer Mode enabled)
DISCORD_DEFAULT_GUILD_ID=

# Default channel ID for testing
DISCORD_DEFAULT_CHANNEL_ID=

# ============================================================================
# THEMING - User Experience
# ============================================================================

# Theme selection: "generic" | "wow" | "custom"
# generic: Standard Discord terminology (channels, members, roles)
# wow: World of Warcraft immersive terminology (summon, muster, forge)
# custom: Load from GUILDMASTER_THEME_PATH
GUILDMASTER_THEME=generic

# Path to custom theme YAML (only if GUILDMASTER_THEME=custom)
GUILDMASTER_THEME_PATH=

# ============================================================================
# COMFYUI INTEGRATION - Optional AI Image Generation
# ============================================================================

# Enable ComfyUI integration for AI-generated guild imagery
COMFYUI_ENABLED=false

# ComfyUI server connection (only if COMFYUI_ENABLED=true)
COMFYUI_HOST=localhost
COMFYUI_PORT=8188

# Directory containing ComfyUI workflow JSON files
COMFYUI_WORKFLOW_DIR=./workflows

# Randomize seeds for varied generations
COMFYUI_RANDOMIZE_SEEDS=true

# Request timeout in seconds
COMFYUI_TIMEOUT=300

# Image delivery mode: "base64" | "url" | "cdn"
# base64: Return images as base64 strings (works everywhere)
# url: Return HTTP URLs to ComfyUI server (local testing only)
# cdn: Upload to CDN and return public URLs (production)
COMFYUI_RETURN_MODE=base64

# CDN configuration (only if COMFYUI_RETURN_MODE=cdn)
COMFYUI_CDN_BUCKET=

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================

# Transport mode: "stdio" | "http"
# stdio: Standard MCP mode for Claude Desktop, Cursor, etc.
# http: HTTP mode for testing and debugging
MCP_TRANSPORT=stdio

# HTTP server port (only if MCP_TRANSPORT=http)
MCP_HTTP_PORT=8080

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Default page size for paginated results
DEFAULT_PAGE_SIZE=50

# Maximum message history to fetch
MAX_MESSAGE_HISTORY=100

# Truncate long responses to save tokens
RESPONSE_TRUNCATION=true
