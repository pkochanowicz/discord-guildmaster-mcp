{
  "mcpServers": {
    "discord-guildmaster": {
      "command": "uv",
      "args": ["--directory", "/path/to/discord-guildmaster-mcp", "run", "guildmaster"],
      "env": {
        "DISCORD_TOKEN": "your_bot_token_here",
        "DISCORD_DEFAULT_GUILD_ID": "your_guild_id_here",
        "COMFYUI_ENABLED": "true",
        "COMFYUI_HOST": "localhost",
        "LOG_LEVEL": "DEBUG"
      }
    }
  }
}
