{
  "mcpServers": {
    "discord-guildmaster": {
      "command": "uv",
      "args": ["run", "guildmaster"],
      "env": {
        "DISCORD_TOKEN": "your_bot_token_here",
        "DISCORD_DEFAULT_GUILD_ID": "your_guild_id_here",
        "GUILDMASTER_THEME": "generic",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}
