# Discord Guildmaster MCP - Test Environment Configuration
# Used for unit testing with mocked Discord API

# Mock Discord token (not a real token)
DISCORD_TOKEN=test_token_mock_12345678901234567890

# Mock guild/channel IDs for testing
DISCORD_DEFAULT_GUILD_ID=123456789012345678
DISCORD_DEFAULT_CHANNEL_ID=987654321098765432

# Generic theme for test consistency
GUILDMASTER_THEME=generic

# Disable ComfyUI for unit tests (mocked separately)
COMFYUI_ENABLED=false

# Debug logging for test runs
LOG_LEVEL=DEBUG

# Standard MCP mode for tests
MCP_TRANSPORT=stdio

# Fast response limits for test speed
DEFAULT_PAGE_SIZE=10
MAX_MESSAGE_HISTORY=20
RESPONSE_TRUNCATION=true
